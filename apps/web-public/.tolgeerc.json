{
  "$schema": "https://docs.tolgee.io/cli-schema.json",
  "apiUrl": "http://localhost:8085",
  "projectId": 2,
  "format": "PO_ICU",
  "push": {
    "files": [
      { "path": "src/shared/i18n/locales/en.po", "language": "en" },
      { "path": "src/shared/i18n/locales/ta.po", "language": "ta" }
    ],
    "forceMode": "OVERRIDE"
  },
  "pull": {
    "path": "src/shared/i18n/locales",
    "languages": ["ta"]
  }
}
