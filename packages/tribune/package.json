{
  "name": "@jp/tribune",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "lint": "biome lint ./src",
    "check:tokens": "tsx scripts/lint-tokens.ts",
    "clean": "git clean -xdf .cache .turbo node_modules",
    "gen:brand-ramp": "node scripts/gen-brand-ramp.mjs",
    "gen:icons": "tsx scripts/generate-icons.ts"
  },
  "exports": {
    "./cn": "./src/lib/utils.ts",
    "./components/button": "./src/components/button/button.tsx",
    "./components/container": "./src/components/container/container.tsx",
    "./components/field": "./src/components/field/field.tsx",
    "./components/heading": "./src/components/typography/heading.tsx",
    "./components/input": "./src/components/input/input.tsx",
    "./components/link": "./src/components/link/link.tsx",
    "./components/otp-input": "./src/components/otp-input/otp-input.tsx",
    "./components/ripple": "./src/components/ripple/ripple.tsx",
    "./components/ripple/use-ripple": "./src/components/ripple/use-ripple.ts",
    "./components/scroll-area": "./src/components/scroll-area/scroll-area.tsx",
    "./components/site-text": "./src/components/site-typography/site-text.tsx",
    "./components/text": "./src/components/typography/text.tsx",
    "./icons/*": "./src/icons/generated/*.tsx",
    "./icons/brand/*": "./src/icons/brand/*.tsx",
    "./icons/types": "./src/icons/icon-props.ts",
    "./lib/use-guarded-text": "./src/lib/use-guarded-text.ts",
    "./styles": "./src/styles/index.css",
    "./styles/app": "./src/styles/app.css",
    "./styles/public": "./src/styles/public.css",
    "./use-media-query": "./src/lib/use-media-query.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource-variable/noto-sans-tamil": "catalog:",
