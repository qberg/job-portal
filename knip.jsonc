{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    // Catalog is pre-wired with the job-portal app fleet's versions
    // (ADR-0013/0014); entries become used as each app lands. Surface, don't fail.
    "catalog": "warn"
  },
  "workspaces": {
    "packages/tribune": {
      // Fontsource faces are consumed from CSS @import only — invisible to knip.
      "ignoreDependencies": [
        "@fontsource-variable/noto-sans-tamil",
        "@fontsource-variable/public-sans",
        "@fontsource/pt-serif"
      ]
    }
  }
}
