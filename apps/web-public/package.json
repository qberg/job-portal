{
  "name": "@jp/web-public",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=2048 dotenv -e ../../.env -- next dev",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check:arch": "depcruise --config .dependency-cruiser.cjs src",
    "map:teaser-basemap": "dotenv -e ../../.env -- node scripts/render-home-teaser-basemap.mjs",
    "knip": "knip",
    "e2e": "playwright test",
    "clean": "git clean -xdf .cache .turbo .next dist node_modules"
  },
  "dependencies": {
    "@jp/api-contract": "workspace:*",
    "@jp/env": "workspace:*",
    "@jp/i18n": "workspace:*",
    "@jp/tribune": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@sentry/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@xstate/react": "catalog:",
    "babel-plugin-macros": "^3.1.0",
    "better-auth": "catalog:",
    "iconsax-reactjs": "^0.0.8",
    "motion": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "valibot": "catalog:",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@jp/typescript-config": "workspace:*",
    "@lingui/swc-plugin": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dependency-cruiser": "catalog:",
    "dotenv-cli": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
